# =========================================================
# Open Ascent — Backend Environment
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

APP_ENV=development

FRONTEND_URL=http://localhost:3000


# ---------------------------------------------------------
# Database
# ---------------------------------------------------------

# Hosted Supabase PostgreSQL connection string.
DATABASE_URL=


# ---------------------------------------------------------
# Supabase
# ---------------------------------------------------------

SUPABASE_URL=

# Server-side only.
# Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket used for uploaded workout videos.
SUPABASE_VIDEO_BUCKET=analysis-videos


# ---------------------------------------------------------
# OpenAI
# ---------------------------------------------------------

OPENAI_API_KEY=

# Final model can be selected during implementation.
OPENAI_MODEL=

# Optional semantic fallback for uncertain vertical-pull dimensions only.
OPENAI_VISUAL_CLASSIFIER_ENABLED=true
OPENAI_VISUAL_CLASSIFIER_MODEL=gpt-5.6-luna
OPENAI_VISUAL_CLASSIFIER_TIMEOUT_SECONDS=30


# ---------------------------------------------------------
# Stripe — TEST MODE ONLY
# ---------------------------------------------------------

# Test secret key: sk_test_...
STRIPE_SECRET_KEY=

# Local Stripe CLI signing secret: run `stripe listen --print-secret`, then copy
# its whsec_... output here before starting the backend. Never commit the value.
STRIPE_WEBHOOK_SECRET=

# Monthly Open Ascent Pro Stripe Price ID: price_...
STRIPE_PRO_PRICE_ID=


# ---------------------------------------------------------
# Guest Analysis Authorization
# ---------------------------------------------------------

# Strong random server-side secret used to sign/verify
# temporary guest-analysis credentials.
GUEST_TOKEN_SECRET=
